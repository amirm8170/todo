PORT=3000
CLIENT_PORT=5173
NODE_ENV=development

# Use "mysql" with Docker Compose.
# Use "localhost" when running the NestJS server on your machine.
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=todo
DB_PASSWORD=todo_password
DB_DATABASE=todo
MYSQL_ROOT_PASSWORD=todo_password
PHPMYADMIN_PORT=8080

# Use long random strings in real projects (at least 32 characters).
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Browser talks to the API on the host, even when the client runs in Docker.
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
