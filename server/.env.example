PORT=3000
NODE_ENV=development

# Use "localhost" when running NestJS on your machine.
# Use "mysql" with Docker Compose (or rely on the root .env in Docker).
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=todo
DB_PASSWORD=todo_password
DB_DATABASE=todo

# Use long random strings in real projects (at least 32 characters).
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# React Vite app origin. Cookies require this to match exactly.
CORS_ORIGIN=http://localhost:5173
